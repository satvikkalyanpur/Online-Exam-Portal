# Copy this file to `.env` (in this same folder) and fill in your MySQL password.

# mysql://USER:PASSWORD@HOST:PORT/DATABASE
# If the password contains @ # / : ? or %, write them as %40 %23 %2F %3A %3F %25
DATABASE_URL="mysql://root:your_password@localhost:3306/online_exam_portal"

# Any long random text. It is used to sign login tokens.
JWT_SECRET="change-this-to-any-long-random-text"

PORT=4000
