{
  "name": "online-exam-portal-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc",
    "postinstall": "prisma generate",
    "db:setup": "prisma generate && prisma db push && prisma db seed",
    "db:reset": "prisma db push --force-reset && prisma db seed",
    "test": "tsx --test --test-concurrency=1 \"test/*.test.ts\"",
    "check": "tsc && npm test"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "tsx": "^4.19.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.21",
    "prisma": "^7.10.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  }
}
